{
  "name": "@cockpitzero/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@cockpitzero/shared": "workspace:*",
    "@hono/node-server": "^1.13.7",
    "@hono/zod-validator": "^0.4.2",
    "drizzle-orm": "^0.38.3",
    "hono": "^4.6.16",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cockpitzero/eslint-config": "workspace:*",
    "@cockpitzero/tsconfig": "workspace:*",
    "@libsql/client": "^0.14.0",
    "@types/node": "catalog:",
    "drizzle-kit": "^0.30.1",
    "eslint": "catalog:",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

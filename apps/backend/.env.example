# HTTP port the server listens on
PORT=8787

# Database connection.
# Local dev (SQLite via libSQL): a file URL.
#   DATABASE_URL=file:./drizzle/dev.sqlite
# Production (Postgres): swap the driver in src/db/index.ts and set:
#   DATABASE_URL=postgres://user:pass@host:5432/cockpitzero
DATABASE_URL=file:./drizzle/dev.sqlite

# Secret for signing auth tokens (stub for now)
AUTH_SECRET=change-me-in-production

NODE_ENV=development

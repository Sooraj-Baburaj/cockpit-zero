# HTTP port the server listens on
PORT=8787

# Postgres connection (dev: `pnpm db:up` starts the docker-compose.yml instance
# these credentials match). Tests use pglite://memory automatically.
DATABASE_URL=postgres://cockpitzero:cockpitzero@localhost:5432/cockpitzero

# better-auth: session signing secret + the public origin of this API
# (OAuth callback URLs derive from BETTER_AUTH_URL).
BETTER_AUTH_SECRET=change-me-in-production
BETTER_AUTH_URL=http://localhost:8787

# Social sign-in (optional — each provider is offered only when both values are
# set; email/password always works without them).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Server-side embeddings for cloud memory + knowledge (P8). Unset = a
# deterministic keyword-hash embedder keeps dev/tests running keyless (recall
# quality degrades to keyword overlap — set the key in production).
# OPENAI_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small

# Managed inference (P9): OUR Anthropic key, server-side only — never ships to
# a client. Unset = /inference responds 503 (managed tier offline). The soft
# per-user rate cap is requests/minute (abuse brake; hard quotas come with
# billing).
# ANTHROPIC_API_KEY=
# INFERENCE_RATE_LIMIT_RPM=30

# Outbound email for verification/reset. Unset = links are logged to the
# server console (dev transport).
# RESEND_API_KEY=
# EMAIL_FROM=CockpitZero <auth@yourdomain.com>

NODE_ENV=development

{
  "name": "@cockpitzero/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "CockpitZero desktop launcher (Electron)",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.1.0",
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "@cockpitzero/eslint-config": "workspace:*",
    "@cockpitzero/shared": "workspace:*",
    "@cockpitzero/tsconfig": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "eslint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "^6.0.7",
    "vitest": "catalog:"
  }
}
